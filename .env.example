NODE_ENV=development
HOST=127.0.0.1
PORT=8000
SITE_URL=http://127.0.0.1:8000
PEERFLOW_DB=data/peerflow.sqlite3
PEERFLOW_MEDIA=media

# true only when a trusted reverse proxy overwrites X-Real-IP.
TRUST_PROXY=false

# Mock records deliveries without sending Slack messages.
MOCK_SLACK_MODE=true
SLACK_BOT_TOKEN=

# Optional system Chromium; otherwise Playwright's installed Chromium is used.
# PDF_CHROMIUM_EXECUTABLE=/absolute/path/to/chromium
