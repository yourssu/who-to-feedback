# ==============================================================================
# PeerFlow v2 — 개인 Cloudflare 계정 테스트 배포 환경 변수 (Placeholder)
# ==============================================================================
# [인증 방법 A] API 토큰 방식 (권장 — 원격 서버/터미널 환경에서 브라우저 없이 바로 배포)
# 1. Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token
#    - "Edit Cloudflare Workers" 템플릿 선택 후 아래 권한이 포함되도록 생성:
#      * Account > Workers Scripts: Edit
#      * Account > D1: Edit
#      * Account > Workers R2 Storage: Edit (R2 사용 시)
#      * Account > Queues: Edit (Queues 사용 시)
# 2. 아래 두 값을 본인의 실제 값으로 교체하세요.
#
# [인증 방법 B] 브라우저 OAuth 로그인 방식 (`npx wrangler login` 사용 시)
# - `npx wrangler login`으로 이미 로그인했다면 아래 두 값은 비워두거나 그대로 두어도 됩니다.
# ------------------------------------------------------------------------------

CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID_HERE"
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN_HERE"

# ------------------------------------------------------------------------------
# [선택 사항] Slack 연동 설정
# - 기본값 MOCK_SLACK_MODE="true" 상태에서는 실제 Slack API를 호출하지 않고
#   발송 이력(PIN 발급, 리마인더, 리포트 발송)을 즉시 SENT로 시뮬레이션합니다.
# - 실제 Slack 워크스페이스로 DM 발송까지 테스트하려면:
#   1) MOCK_SLACK_MODE="false" 로 변경
#   2) SLACK_BOT_TOKEN 에 "xoxb-..." Bot User OAuth Token 입력
#      (필요 OAuth Scope: users:read, users:read.email, im:write, chat:write, files:write)
#   3) SITE_URL 에 배포된 "*.workers.dev" 주소 입력 (미입력 시 DM 내 링크에 기본 도메인 표기)
# ------------------------------------------------------------------------------

MOCK_SLACK_MODE="true"
SLACK_BOT_TOKEN="xoxb-YOUR-SLACK-BOT-TOKEN-HERE"
SITE_URL=""
